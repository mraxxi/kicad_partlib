# Secrets. The Cloudflare token lives in $XDG_CONFIG_HOME/kicad_partlib/,
# outside this repository, and must never be committed. This line is a
# second line of defence in case someone drops one in here by hand.
secrets.json
.env
.dev.vars
!.dev.vars.example

# Database exports. These contain the whole inventory and are the backup of
# record (docs/d1-setup.md). They are deliberately NOT tracked: git is for
# code here, and a 5 MB SQL dump per backup would dominate the history.
backups/
*.sql.gz

# node_modules/ doubles as wrangler's writable cache dir: a root-owned
# /home/archvan/node_modules up-tree otherwise breaks wrangler. docs/d1-setup.md.
node_modules/
.wrangler/

# Per-machine Claude Code permissions. `.claude/settings.json` is shared if one
# is ever added; the `.local` variant is this machine's and must not be.
.claude/settings.local.json

# Desktop environments
.directory
.DS_Store
Thumbs.db

# Built web app (vite build -> public/); only the placeholder is tracked.
public/*
!public/.gitkeep

# Python bytecode (left over from the Phase-0 Python tests; never track it).
__pycache__/
*.pyc
